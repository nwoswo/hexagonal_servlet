	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Script que se ejecuta antes de cada request",
					"console.log('Ejecutando request: ' + pm.request.name);"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Script que se ejecuta después de cada request",
					"pm.test('Status code is 200', function () {",
					"    pm.response.to.have.status(200);",
					"});",
					"",
					"pm.test('Response time is less than 2000ms', function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(2000);",
					"});",
					"",
					"// Guardar el ID de la orden si se crea exitosamente",
					"if (pm.response.code === 201 && pm.request.name.includes('Crear')) {",
					"    const response = pm.response.json();",
					"    if (response && response.id) {",
					"        pm.collectionVariables.set('ordenId', response.id);",
					"        pm.collectionVariables.set('numeroOrden', response.numeroOrden);",
					"        console.log('Orden creada con ID: ' + response.id);",
					"    }",
					"}"
				]
			}
		}
	],
